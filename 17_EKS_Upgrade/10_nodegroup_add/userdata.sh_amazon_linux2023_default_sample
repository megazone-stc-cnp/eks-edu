#!/bin/bash

# Set Variables
EC2_NAME_PREFIX=hcseo-node
VOL_NAME_PREFIX=hcseo-node-volume

EKS_CLUSTER_NAME=mzc-an1-hcseo-stg
EKS_NODE_GROUP_NAME=kr-default-v31
EKS_REGION=ap-northeast-1

# EC2 Name Tag
EC2_IP=$(ifconfig eth0 | grep -w inet | awk '{ print $2 }'  | tr '.' '-' )
if  [ -z $EC2_IP ]; then
  EC2_IP=$(ifconfig ens5 | grep -w inet | awk '{ print $2 }'  | tr '.' '-' )
fi
if  [ -z $EC2_IP ]; then
  EC2_IP=$(ifconfig enp39s0 | grep -w inet | awk '{ print $2 }'  | tr '.' '-' )
fi
EC2_NAME=${EC2_NAME_PREFIX}"-"${EC2_IP}
TOKEN=`curl -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600"`
EC2_ID=`curl -H "X-aws-ec2-metadata-token: ${TOKEN}" -v http://169.254.169.254/latest/meta-data/instance-id/`

# EBS Root Volume Name Tag
VOL_ID=`aws ec2 describe-instances --instance-ids ${EC2_ID} --region ${EKS_REGION} --query 'Reservations[0].Instances[0].BlockDeviceMappings[0].Ebs.VolumeId' --output text`
VOL_NAME=${VOL_NAME_PREFIX}"-"${EC2_IP}"-"root
echo $(aws ec2 create-tags --resources ${EC2_ID} --tags Key="Name",Value=${EC2_NAME} --region ${EKS_REGION})
echo $(aws ec2 create-tags --resources ${VOL_ID} --tags Key="Name",Value=${VOL_NAME} --region ${EKS_REGION})

#bootstrap
B64_CLUSTER_CA=$( aws eks describe-cluster --query "cluster.certificateAuthority.data" --output text --name ${EKS_CLUSTER_NAME} --region ${EKS_REGION} )
API_SERVER_URL=$( aws eks describe-cluster --query "cluster.endpoint" --output text --name ${EKS_CLUSTER_NAME} --region ${EKS_REGION} )
K8S_CLUSTER_DNS_IP=$( aws eks describe-cluster --query "cluster.kubernetesNetworkConfig.serviceIpv4Cidr" --output text --name ${EKS_CLUSTER_NAME} --region ${EKS_REGION} )

cat << EOF >> /root/nodeadm.yaml
---
apiVersion: node.eks.aws/v1alpha1
kind: NodeConfig
spec:
  cluster:
    name: ${EKS_CLUSTER_NAME}
    apiServerEndpoint: ${API_SERVER_URL}
    certificateAuthority: ${B64_CLUSTER_CA}
    cidr: ${K8S_CLUSTER_DNS_IP}
EOF

nodeadm init -c=file:///root/nodeadm.yaml
